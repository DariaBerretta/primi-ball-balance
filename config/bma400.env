# The shell launcher sources this file; use KEY=value assignments only.
# Persistent USB identifier for the tested Adafruit Feather nRF52840 Express.
BMA400_SERIAL_PORT=/dev/serial/by-id/usb-Adafruit_Feather_nRF52840_Express_5B115F67DDDFD9DA-if00
BMA400_BAUD=115200
BMA400_YARP_PORT=/primi-ball-balance/imu/bma400:o
BMA400_READ_TIMEOUT=1.0
BMA400_MAX_SILENCE=10.0

# Leave empty to disable CSV recording. An example is:
# BMA400_CSV=data/bma400_run.csv
BMA400_CSV=
