# ============================================================
# PRIMI - Online MoveEnet + Optical Flow + Kalman Filter
# ============================================================

# Camera selection and sensor resolution.
CAMERA="left"
WIDTH=640
HEIGHT=480

# ------------------------------------------------------------
# Processing frequencies
# ------------------------------------------------------------

# Neural network inference frequency (Hz).
F_NET=5

# Event-based optical flow frequency (Hz).
F_FLOW=200

# EROS and skeleton visualization frequency (Hz).
F_VIS=60

# ------------------------------------------------------------
# Human Pose Estimation
# ------------------------------------------------------------

# Radius of the region used for optical flow around each joint.
ROI=20

# Minimum confidence required to accept a MoveEnet joint.
CONFIDENCE_TH=0.2

# Maximum age of a joint detection before tracking expires.
TRACK_TIMEOUT=1.0

# ------------------------------------------------------------
# Kalman Filter and Latency Compensation
# ------------------------------------------------------------

# Process uncertainty.
PU=0.77

# Position measurement uncertainty.
MUD=0.06

# Retained for compatibility with the existing launcher.
MUV=0.97

# Enable latency compensation.
USE_LC=true

# ------------------------------------------------------------
# Event Noise Filtering
# ------------------------------------------------------------

# Start without filtering to establish a reference.
NOISE_FILTER=true

# Temporal refractory period in milliseconds.
NOISE_REFRACTORY_MS=0.0

# Spatial coincidence window in milliseconds.
NOISE_SPATIAL_MS=5

# Spatial neighborhood radius in pixels.
NOISE_RADIUS=1

# ------------------------------------------------------------
# Visualization
# ------------------------------------------------------------

# Display raw MoveEnet predictions in red.
SHOW_MOVENET=true

# Display optical-flow and Kalman predictions in green.
SHOW_OFK=true

# Open the overlay visualization automatically.
AUTO_VIEW_OVERLAY=true

# ------------------------------------------------------------
# Python and YARP
# ------------------------------------------------------------

HPE_CORE_DIR="$HOME/robot-code/hpe-core"

CHECKPOINT="$HOME/robot-code/hpe-core/example/movenet/models/upper.pth"

LOCAL_CARRIER="shmem"