# PRIMI online upper-body pose estimation. Source: eventCam_reader local output.
CAMERA="left"                 # left or right; launch ONE at a time
WIDTH=640
HEIGHT=480
F_NET=50
F_FLOW=200
# Overlay is rendered at f_vis, not at f_flow (avoids 200 Hz RGB video).
F_VIS=30
# Display both estimators on the same EROS image, red = raw NN, green = OF+KF.
SHOW_MOVENET=true
SHOW_OFK=true
ROI=20
CONFIDENCE_TH=0.2
TRACK_TIMEOUT=1.0
PU=0.77
MUD=0.06
MUV=0.97
USE_LC=true

# Event-domain denoising, applied BEFORE EROS and SAE (does not alter raw:o).
# Start with 1ms same-polarity refractory and 5ms support from a neighboring
# pixel (radius=1). Set NOISE_FILTER=false for an A/B raw-vs-filtered test.
NOISE_FILTER=true
NOISE_REFRACTORY_MS=1.0
NOISE_SPATIAL_MS=5.0
NOISE_RADIUS=1
HPE_CORE_DIR="$HOME/robot-code/hpe-core"
CHECKPOINT="$HOME/robot-code/hpe-core/example/movenet/models/upper.pth"
LOCAL_CARRIER="shmem"        # Both readers/processes run on iiticublap267
AUTO_VIEW_OVERLAY=true
