#============ RGB reader outputs ============

RGB_LEFT_RAW_SOURCE="/primi-ball-balance/rgbCam/left/raw:o"
RGB_RIGHT_RAW_SOURCE="/primi-ball-balance/rgbCam/right/raw:o"

RGB_LEFT_PROCESSED_SOURCE="/primi-ball-balance/rgbCam/left/processed:o"
RGB_RIGHT_PROCESSED_SOURCE="/primi-ball-balance/rgbCam/right/processed:o"

RGB_LEFT_DETECTION_SOURCE="/primi-ball-balance/rgbCam/left/detection:o"
RGB_RIGHT_DETECTION_SOURCE="/primi-ball-balance/rgbCam/right/detection:o"

#============ Event camera sources ============

EVENT_LEFT_SOURCE="/primi-ball-balance/eventCam/left:i"
EVENT_RIGHT_SOURCE="/primi-ball-balance/eventCam/right:i"

EVENT_WIDTH=640
EVENT_HEIGHT=480
EVENT_FPS=60

#============ YARP scope ============

# Ball centre x-coordinate from:
# [valid, center_x, center_y, radius, confidence, timestamp]
SCOPE_REMOTE="/primi-ball-balance/rgbCam/left/detection:o"
SCOPE_INDEX=1
SCOPE_MIN=0
SCOPE_MAX=640

#============ Display ============

MONITOR_X=0
MONITOR_Y=0

# Zero means use the current screen resolution.
MONITOR_WIDTH=0
MONITOR_HEIGHT=0

WINDOW_GAP=4