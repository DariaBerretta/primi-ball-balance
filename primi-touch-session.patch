+#!/usr/bin/env python3
+"""Plot a touch recording and optional BMA400 stream after capture."""
+
+import argparse
+from pathlib import Path
+
+import matplotlib
+
+matplotlib.use("Agg")
+import matplotlib.pyplot as plt
+from matplotlib.colors import Normalize
+import numpy as np
+
+
+HAND_AREAS = {
+    "Thumb": slice(48, 60),
+    "Index": slice(0, 12),
+    "Middle": slice(12, 24),
+    "Ring": slice(24, 36),
+    "Little": slice(36, 48),
+    "Palm": slice(96, 144),
+}
+
+
+def load_log(path):
+    # A YARP Bottle can enclose the payload in parentheses.
+    delimiters = str.maketrans("()", "  ")
+    with path.open() as log:
+        data = np.loadtxt((line.translate(delimiters) for line in log), ndmin=2)
+    if not data.size:
+        raise ValueError(f"No samples in {path}")
+    return data
+
+
+def plot_session(session):
+    touch_path = session / "touch" / "data.log"
+    if touch_path.exists():
+        touch = load_log(touch_path)
+        time_column = 2  # packet ID, sender timestamp, receiver timestamp
+        acceleration_path = session / "bma400" / "data.log"
+        acceleration = load_log(acceleration_path) if acceleration_path.parent.is_dir() else None
+        time_label = "Time since first receiver timestamp (s)"
+    else:
+        touch = load_log(session / "data.log")
+        time_column = 1  # original touch-only script's single timestamp
+        acceleration = None
+        time_label = "Time since first logged timestamp (s)"
+
+    taxels = touch[:, time_column + 1:]
+    if not taxels.shape[1]:
+        raise ValueError("Touch log has no taxel columns.")
+    if acceleration is not None and acceleration.shape[1] != 8:
+        raise ValueError("Expected three dumper columns and five BMA400 fields.")
+
+    first_time = touch[0, time_column]
+    if acceleration is not None:
+        first_time = min(first_time, acceleration[0, time_column])
+    touch_time = touch[:, time_column] - first_time
+
+    standard_hand = taxels.shape[1] == 192
+    touch_rows = 3 if standard_hand else 1
+    rows = touch_rows + (acceleration is not None)
+    fig = plt.figure(figsize=(13, 3.1 * rows + 0.7), constrained_layout=True)
+    grid = fig.add_gridspec(rows, 2)
+    first_axis = None
+
+    if standard_hand:
+        for index, (area, channels) in enumerate(HAND_AREAS.items()):
+            ax = fig.add_subplot(grid[index // 2, index % 2], sharex=first_axis, sharey=first_axis)
+            if first_axis is None:
+                first_axis = ax
+            ids = np.arange(channels.start, channels.stop)
+            norm = Normalize(ids[0], ids[-1])
+            ax.set_prop_cycle(color=plt.cm.viridis(norm(ids)))
+            ax.plot(touch_time, taxels[:, channels], linewidth=0.8,
+                    marker="." if len(touch_time) == 1 else None)
+            ax.set_title(area)
+            ax.grid(alpha=0.25)
+            fig.colorbar(plt.cm.ScalarMappable(norm=norm, cmap="viridis"), ax=ax,
+                         label="Taxel ID", ticks=[ids[0], ids[-1]])
+            if index % 2 == 0:
+                ax.set_ylabel("Compensated taxel value (a.u.)")
+    else:
+        first_axis = fig.add_subplot(grid[0, :])
+        first_axis.plot(touch_time, taxels, linewidth=0.8,
+                        marker="." if len(touch_time) == 1 else None)
+        first_axis.set_title(f"{taxels.shape[1]} taxels")
+        first_axis.set_ylabel("Compensated taxel value (a.u.)")
+        first_axis.grid(alpha=0.25)
+
+    if acceleration is not None:
+        ax = fig.add_subplot(grid[-1, :], sharex=first_axis)
+        for index, axis in enumerate(("X", "Y", "Z")):
+            ax.plot(acceleration[:, 2] - first_time, acceleration[:, 4 + index],
+                    label=axis, linewidth=1.0)
+        ax.set_title("BMA400")
+        ax.set_ylabel("Acceleration (m/s²)")
+        ax.legend(ncol=3)
+        ax.grid(alpha=0.25)
+
+    fig.suptitle("Right-hand touch and acceleration" if acceleration is not None else "Right-hand touch")
+    fig.supxlabel(time_label)
+    output = session / "taxels_by_area.png"
+    fig.savefig(output, dpi=180)
+    plt.close(fig)
+    return output
+
+
+if __name__ == "__main__":
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("session", type=Path, help="Recording session directory")
+    args = parser.parse_args()
+    try:
+        output = plot_session(args.session)
+    except (OSError, ValueError) as error:
+        parser.exit(1, f"{error}\n")
+    print(f"Saved plot to {output}")
